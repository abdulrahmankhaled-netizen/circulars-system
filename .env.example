# ===========================================
# Application
# ===========================================
APP_NAME="نظام إدارة العقود"
SECRET_KEY=change-this-to-a-very-long-random-string-in-production-2026
FLASK_ENV=development
FLASK_DEBUG=1

# ===========================================
# Database
# ===========================================
DATABASE_URL=sqlite:///instance/app.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/contracts_db

# ===========================================
# Uploads
# ===========================================
MAX_CONTENT_LENGTH_MB=32

# ===========================================
# API
# ===========================================
EXTERNAL_API_KEY=change-this-api-key-please

# ===========================================
# Initial Admin
# ===========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@2026
ADMIN_FULL_NAME=مدير النظام
ADMIN_EMAIL=admin@example.com